# Copy this file to .env and fill in your own values

# Flask
SECRET_KEY=change-this-to-a-long-random-string
FLASK_ENV=production

# Database
# For quick local use / easiest deployment (recommended to start):
DATABASE_URL=sqlite:///pharmacy.db

# For MySQL in production (uncomment and fill in, then: pip install pymysql)
# DATABASE_URL=mysql+pymysql://<db_user>:<db_password>@<db_host>:3306/<db_name>

# Shop details (used on printed invoices)
SHOP_NAME=City Care Pharmacy
SHOP_ADDRESS=123 MG Road, Pune, Maharashtra - 411001
SHOP_PHONE=+91 98765 43210
SHOP_GSTIN=27ABCDE1234F1Z5

# Default admin account created on first run (change the password after first login!)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=Admin@12345

# AI Assistant (optional) — leave blank to disable the "AI Assistant" admin page.
# Get a key at https://console.anthropic.com — billed separately from anything
# else in this project, based on your own Anthropic account usage.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
